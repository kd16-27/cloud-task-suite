{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cloud Task Lab \u2014 Fargate autoscaling + encrypted private PostgreSQL + HTTPS. Creates billable resources.",
  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "Description": "ECR image URI ending in an immutable digest or reviewed tag"
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "Issued ACM certificate ARN in this region for DomainName"
    },
    "DomainName": {
      "Type": "String",
      "Description": "Owned hostname, e.g. lab.example.com"
    },
    "AdminEmail": {
      "Type": "String",
      "Description": "Initial demo admin email; use fictional data"
    },
    "DatabaseMultiAZ": {
      "Type": "String",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false",
      "Description": "Enable for database failover; increases charges"
    }
  },
  "Conditions": {
    "UseMultiAZ": {
      "Fn::Equals": [
        {
          "Ref": "DatabaseMultiAZ"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "AttachGateway": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "AttachGateway"
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetA"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetB"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.12.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "HTTPS public entry; HTTP redirects",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "AppSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Only load balancer can reach application",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          }
        ]
      }
    },
    "DbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Only application tasks can reach PostgreSQL",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "AppSecurity"
            }
          }
        ]
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Isolated database subnets",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetB"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageEncrypted": true,
        "StorageType": "gp3",
        "DBName": "cloudlab",
        "MasterUsername": "labadmin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurity"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": {
          "Fn::If": [
            "UseMultiAZ",
            true,
            false
          ]
        },
        "BackupRetentionPeriod": 7,
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "AppDbSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Restricted application database password",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"labapp\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      }
    },
    "EncryptionSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "High entropy encryption and pass signing root secret",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AdminSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Initial demonstration administrator password",
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadTaskSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    },
                    {
                      "Ref": "AppDbSecret"
                    },
                    {
                      "Ref": "EncryptionSecret"
                    },
                    {
                      "Ref": "AdminSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "initialize",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": false,
            "Command": [
              "python",
              "-m",
              "suite.init_cloud"
            ],
            "Environment": [
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_NAME",
                "Value": "cloudlab"
              },
              {
                "Name": "DB_SSLROOTCERT",
                "Value": "/app/cloud/global-bundle.pem"
              },
              {
                "Name": "DB_USER",
                "Value": "labadmin"
              },
              {
                "Name": "ADMIN_EMAIL",
                "Value": {
                  "Ref": "AdminEmail"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "APP_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppDbSecret}:password::"
                }
              },
              {
                "Name": "ADMIN_PASSWORD",
                "ValueFrom": {
                  "Ref": "AdminSecret"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "cloudlab"
              }
            }
          },
          {
            "Name": "web",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "DependsOn": [
              {
                "ContainerName": "initialize",
                "Condition": "SUCCESS"
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_NAME",
                "Value": "cloudlab"
              },
              {
                "Name": "DB_SSLROOTCERT",
                "Value": "/app/cloud/global-bundle.pem"
              },
              {
                "Name": "DB_USER",
                "Value": "labapp"
              },
              {
                "Name": "AUTO_INIT",
                "Value": "false"
              },
              {
                "Name": "TRUST_PROXY",
                "Value": "true"
              },
              {
                "Name": "APP_HOST",
                "Value": "0.0.0.0"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppDbSecret}:password::"
                }
              },
              {
                "Name": "ENCRYPTION_SECRET",
                "ValueFrom": {
                  "Ref": "EncryptionSecret"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "cloudlab"
              }
            }
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DesiredCount": 2,
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "HealthCheckGracePeriodSeconds": 180,
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "PublicSubnetA"
              },
              {
                "Ref": "PublicSubnetB"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "AppSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            },
            "ContainerName": "web",
            "ContainerPort": 8080
          }
        ]
      },
      "DependsOn": [
        "HttpsListener",
        "DefaultRoute"
      ]
    },
    "ScalingRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "application-autoscaling.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScaleEcsService",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:DescribeServices",
                    "ecs:UpdateService"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Service",
                      "ServiceArn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricAlarm",
                    "cloudwatch:DescribeAlarms",
                    "cloudwatch:DeleteAlarms"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "ScalableTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": 2,
        "MaxCapacity": 4,
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${Service.Name}"
        },
        "RoleARN": {
          "Fn::GetAtt": [
            "ScalingRole",
            "Arn"
          ]
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "CpuScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "CloudLabCpuTarget",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60.0,
          "ScaleInCooldown": 120,
          "ScaleOutCooldown": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    }
  },
  "Outputs": {
    "AppUrl": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "LoadBalancerDns": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    },
    "AdminPasswordSecretArn": {
      "Value": {
        "Ref": "AdminSecret"
      }
    },
    "EncryptionSecretArn": {
      "Value": {
        "Ref": "EncryptionSecret"
      }
    },
    "DatabaseIdentifier": {
      "Value": {
        "Ref": "Database"
      }
    }
  }
}
